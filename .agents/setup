#!/usr/bin/env bash
set -euo pipefail

# Orb setup for tools-ai-swe-growth
# This is a Markdown-only documentation repository: no toolchain,
# dependencies, databases, or services are required.

echo "=== [setup] tools-ai-swe-growth ==="
start_ts=$(date +%s)

# Verify the only required tool is available.
if ! command -v git >/dev/null 2>&1; then
  apt-get update -qq
  apt-get install -y -qq git
fi

echo "git: $(git --version)"

end_ts=$(date +%s)
echo "=== [setup] done in $((end_ts - start_ts))s ==="
